generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  SOLD
  HIDDEN
}

enum PaymentMethod {
  COD
  UPI
}

enum PaymentStatus {
  payment_pending
  verification_pending
  confirmed
  cancelled
}

enum OrderStatus {
  pending
  processing
  accepted
  rejected
  shipped
  delivered
  cancelled
}

enum ReportTargetType {
  LISTING
  SELLER
}

model User {
  id           String   @id @default(uuid())
  clerkId      String?  @unique
  name         String
  email        String   @unique
  password     String?
  profileImage String?
  collegeName  String?
  isVerified   Boolean  @default(false)
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  mobileNumber String?
  location     String?
  bio          String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?

  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?
  policyVersion   String?

  products              Product[]
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages              Message[]
  ordersAsBuyer         Order[]        @relation("OrderBuyer")
  ordersAsSeller        Order[]        @relation("OrderSeller")
  favourites            Favourite[]
  cartItems             CartItem[]
  reports               Report[]       @relation("ReportReporter")

  @@index([email])
  @@index([role])
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String        @id @default(uuid())
  title       String
  description String
  price       Decimal       @db.Decimal(10, 2)
  condition   String
  contactNumber String?
  images      String[]
  isSold      Boolean       @default(false)
  isHidden    Boolean       @default(false)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  conversations Conversation[]
  orders        Order[]
  favourites    Favourite[]
  cartItems     CartItem[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Conversation {
  id            String    @id @default(uuid())
  productId     String
  buyerId       String
  sellerId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyer User @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  seller User @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([buyerId, sellerId, productId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  deliveredAt    DateTime?
  seenAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  isSystem       Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Order {
  id                String        @id @default(uuid())
  productId         String
  buyerId           String
  sellerId          String
  amount            Decimal       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(payment_pending)
  utrNumber         String?
  paymentScreenshot String?
  orderStatus       OrderStatus   @default(pending)
  mobileNumber      String?
  locationDetails   String        @default("")
  rejectionReason   String?
  createdAt         DateTime      @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([sellerId])
  @@index([orderStatus])
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  description String?
  createdAt   DateTime         @default(now())

  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([reporterId])
  @@index([targetType, targetId])
}
